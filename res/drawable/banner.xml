<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF111418" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:left="130dp" android:top="60dp" android:right="130dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#FFF2EDE4" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
